@{
    ViewBag.Title = "The Solar System - Learn All";
}

<main class="d-flex flex-column min-vh-100" style="background-color: #0E0639;">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-opacity-75"
         style="background-color: #23156B; ">
        <div class="container">
            @Html.ActionLink("The Solar System", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold fs-2 col" })
            <div class="col d-flex align-items-center justify-content-center h-100">
                <img src="@(Url.Content("~/Content/Assets/flame.svg"))" alt="Streak" class="img-fluid pe-3"
                     style="max-width: 75%; max-height: 54px;"/>
                <p class="fw-bold fs-4 m-0 align-self-center text-light">@ViewBag.LearningStreak</p>
            </div>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-end col">
                <ul class="navbar-nav">
                    <li>@Html.ActionLink("Dashboard", "Dashboard", "Dashboard", new { area = "" }, new { @class = "btn btn-primary border-0 bg-light text-dark fw-bold" })</li>
                    <li>
                        <form method="post" action="">
                            <button type="submit" class="btn border-0 ms-2 fw-bold" style="background-color: #E232EF;">
                                Log Out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <section class="container d-flex flex-column mt-5 flex-grow-1 align-items-center justify-content-center">
        <div class="d-flex flex-column align-items-center bg-light rounded rounded-2 w-50 overflow-hidden p-2"
             style="height: 32rem;">
            <p class="fw-bold fs-2">Question ID: @ViewBag.Flashcard.Id</p>
            <div class="d-flex h-100 align-items-center">
                @if (!ViewBag.revealed)
                {
                    <p class="text-wrap fs-4">@ViewBag.Flashcard.Question</p>
                }
                else
                {
                    <p class="text-wrap fs-4">@ViewBag.Flashcard.Answer</p>
                }
            </div>
        </div>
        <div class="d-flex mt-4 w-50 justify-content-between">
            @if (!ViewBag.revealed)
            {
                if (ViewBag.index != 1)
                {
                    @Html.ActionLink("Back", "Learn", "Deck", new { id = ViewBag.deckId, index = (ViewBag.index - 1), revealed = !ViewBag.revealed }, new { @class = "btn fw-bold btn-danger border-0" })
                }
                else
                {
                    @Html.ActionLink("Return to Deck", "Deck", "Deck", new { id = ViewBag.deckId }, new { @class = "btn fw-bold btn-danger border-0" })
                }

                @Html.ActionLink("Reveal", "Learn", "Deck", new { id = ViewBag.deckId, index = ViewBag.index, revealed = !ViewBag.revealed }, new { @class = "btn fw-bold btn-success border-0 ms-2" })
            }
            else
            {
                @Html.ActionLink("Back", "Learn", "Deck", new { index = ViewBag.index, revealed = !ViewBag.revealed }, new { @class = "btn fw-bold btn-danger border-0" })
                if (ViewBag.flashcardsAmount == ViewBag.Index)
                {
                    using (Html.BeginForm("FinishLearningSession", "Deck", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="deckId" name="deckId" value="@ViewBag.deckId"/>

                        <button type="submit" class="btn fw-bold bg-white border-0 ms-2">
                            Finish
                        </button>
                    }
                }
                else
                {
                    @Html.ActionLink("Next", "Learn", "Deck", new { id = ViewBag.deckId, index = (ViewBag.index + 1), revealed = !ViewBag.revealed }, new { @class = "btn fw-bold btn-success border-0 ms-2" })
                }
            }
        </div>
    </section>
</main>